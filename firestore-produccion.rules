rules_version = '2';
// ═══════════════════════════════════════════════
//  Reglas de fen-produccion  v1.2.0  (Cocina + Sistema Fën)
//  Van en la consola de Firebase → Firestore → Reglas (esta copia es de respaldo).
//
//  · Administración (Sistema Fën): admins/{uid}. Lee y escribe todo.
//  · Cada área tiene UNA cuenta (cuentas/{uid} = { area: 'PAN' | 'BOL' | 'PAS' | 'CAF' }),
//    con la que se autoriza la tablet. Lee recetas y materias primas (sin costos: los
//    costos no se guardan en esta base), y escribe solo lo de su área: planes, el día
//    (hechos, notas, tandas), los ajustes de harina/agua y las metas de Bollería.
//  · v1.1.0: colección metas (Bollería: metas semanales y masas a elaborar).
//  · v1.2.0: propuestas de recetas (la jefa propone; solo Administración aprueba o devuelve)
//    y solicitudes de materias primas (la jefa pide; Administración resuelve); versiones anteriores
//    de las recetas (solo Administración).
//  · Nadie borra: lo que tiene historia no se elimina.
// ═══════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {
    function dentro() { return request.auth != null; }
    function admin() { return dentro() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function cuenta() { return get(/databases/$(database)/documents/cuentas/$(request.auth.uid)).data; }
    function deArea() { return dentro() && exists(/databases/$(database)/documents/cuentas/$(request.auth.uid)); }
    function miArea() { return cuenta().area; }
    // El documento es de mi área (id "PAN_…" y campo area = PAN). Para listar (consultas) se
    // exige filtrar por area: las reglas no pueden revisar el id en una consulta.
    function idDeMiArea(id) { return id.matches('^' + miArea() + '_.+'); }
    function areaDeDatos(d) { return d.area == miArea(); }
    function texto(v, max) { return v is string && v.size() <= max; }

    match /admins/{uid} { allow read: if dentro() && request.auth.uid == uid; allow write: if false; }
    match /cuentas/{uid} { allow read: if dentro() && (request.auth.uid == uid || admin()); allow write: if admin(); }

    // Personas que entran con PIN (nombre, correo y áreas; el PIN lo revisa Asistencia)
    match /personas/{id} { allow read: if admin() || deArea(); allow write: if admin(); }

    // Recetas y materias primas: las cambia Administración (y más adelante las jefas con versiones)
    match /recetas/{id} { allow read: if admin() || deArea(); allow write: if admin(); }
    match /mps/{id} { allow read: if admin() || deArea(); allow write: if admin(); }

    // Configuración: config/{AREA} (masa madre, poolish, capacidades). La jefa lee la suya.
    match /config/{id} { allow read: if admin() || (deArea() && id == miArea()); allow write: if admin(); }

    // Plan semanal: planes/{AREA}_{lunes}. Cada celda se guarda por separado.
    match /planes/{id} {
      allow get: if admin() || (deArea() && idDeMiArea(id));
      allow list: if admin() || (deArea() && resource.data.area == miArea());
      allow create, update: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && request.resource.data.lunes is string && request.resource.data.filas is map);
      allow delete: if false;
    }

    // El día: dias/{AREA}_{fecha} (hechos, notas, tandas)
    match /dias/{id} {
      allow get: if admin() || (deArea() && idDeMiArea(id));
      allow list: if admin() || (deArea() && resource.data.area == miArea());
      allow create, update: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && request.resource.data.fecha is string);
      allow delete: if false;
    }

    // Bollería: metas/{AREA}_{lunes de la meta} (piezas por producto y masas a elaborar la semana anterior). Cada celda por separado.
    match /metas/{id} {
      allow get: if admin() || (deArea() && idDeMiArea(id));
      allow list: if admin() || (deArea() && resource.data.area == miArea());
      allow create, update: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && request.resource.data.lunes is string);
      allow delete: if false;
    }

    // Propuestas de recetas: propuestas/{AREA}_{id}. La jefa escribe borrador, en prueba, en revisión o anulada;
    // "devuelta", "aprobando" y "aprobada" las pone Administración.
    match /propuestas/{id} {
      allow get: if admin() || (deArea() && idDeMiArea(id));
      allow list: if admin() || (deArea() && resource.data.area == miArea());
      allow create: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && request.resource.data.estado in ['borrador', 'en_prueba', 'en_revision']);
      // En revisión no se cambian los datos (solo retirarla o anularla); "aprobando" (mientras Administración
      // la aprueba), aprobada y anulada ya no se tocan.
      allow update: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && !(resource.data.estado in ['aprobando', 'aprobada', 'anulada'])
        && request.resource.data.estado in ['borrador', 'en_prueba', 'en_revision', 'devuelta', 'anulada']
        && (request.resource.data.estado != 'devuelta' || resource.data.estado == 'devuelta')
        && (resource.data.estado != 'en_revision' || (request.resource.data.datos == resource.data.datos
            && request.resource.data.estado in ['en_revision', 'borrador', 'anulada'])));
      allow delete: if false;
    }

    // Materias primas pedidas: solicitudes/{AREA}_{id}. La jefa solo crea (pendiente); Administración resuelve.
    match /solicitudes/{id} {
      allow get: if admin() || (deArea() && idDeMiArea(id));
      allow list: if admin() || (deArea() && resource.data.area == miArea());
      allow create: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && request.resource.data.estado == 'pendiente' && texto(request.resource.data.nombre, 80));
      allow update: if admin();
      allow delete: if false;
    }

    // Ajustes de harina/agua por receta: ajustes/{AREA}_{recetaId} (períodos; el último que cubre un día vale)
    match /ajustes/{id} {
      allow get: if admin() || (deArea() && idDeMiArea(id));
      allow list: if admin() || (deArea() && resource.data.area == miArea());
      allow create, update: if admin() || (deArea() && idDeMiArea(id) && areaDeDatos(request.resource.data)
        && texto(request.resource.data.recetaId, 60) && request.resource.data.periodos is list && request.resource.data.periodos.size() <= 30);
      allow delete: if false;
    }

    // Versiones anteriores de las recetas (las guarda Sistema Fën al aprobar un cambio)
    match /versiones/{id} { allow read, write: if admin(); }

    // Registro de la copia desde la planilla (solo Sistema Fën)
    match /migracion/{id} { allow read, write: if admin(); }
  }
}
